{erl_opts, []}.

{deps, [
    {fast_pbkdf2, "~> 2.0"}
]}.

{project_plugins, [
    {rebar3_hex, "~> 7.0"},
    {rebar3_ex_doc, "~> 0.2"},
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.6"}
]}.

{profiles, [
    {test, [
        {erl_opts, []},
        {plugins, [
            {rebar3_codecov, "0.7.0"}
        ]},
        {cover_enabled, true},
        {cover_export_enabled, true}
    ]},
    {prod, [
        {erl_opts, [inline_list_funcs, deterministic]}
    ]}
]}.

{erlfmt, [
    write,
    {files, [
        "src/*.{hrl,erl,app.src}",
        "test/*.{hrl,erl,app.src}",
        "rebar.config"
    ]}
]}.

{elvis, [
    {config, [
        #{
            files => ["src/**/*.erl"],
            ruleset => erl_files,
            rules => [
                {elvis_style, private_data_types, disable},
                {elvis_style, dont_repeat_yourself, disable},
                {elvis_style, atom_naming_convention, #{
                    regex => "^([a-z][a-zA-Z0-9_]*_?)*$"
                }}
            ]
        },
        #{
            files => ["rebar.config"],
            ruleset => rebar_config
        },
        #{
            files => ["src/**/*.hrl"],
            ruleset => hrl_files,
            rules => [
                {elvis_style, no_includes, disable}
            ]
        }
    ]}
]}.

{hex, [
    {doc, #{provider => ex_doc}}
]}.
{ex_doc, [
    {source_url, <<"https://github.com/esl/fast_scram">>},
    {main, <<"readme">>},
    {extras, [
        {'README.md', #{title => <<"README">>}},
        {'LICENSE', #{title => <<"License">>}}
    ]},
    {main, <<"readme">>}
]}.
